# ===================================================================
# ตัวอย่างค่า environment สำหรับรันด้วย Docker Compose
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
# ===================================================================

# --- บัญชีแอดมินเริ่มต้น (ใช้ตอน init ฐานข้อมูลครั้งแรก) ---
# ควรเปลี่ยน ADMIN_PASSWORD เป็นค่าอื่นก่อนใช้งานจริง
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456

# --- การเชื่อมต่อ Ollama ---
# เมื่อรันผ่าน docker-compose ให้ชี้ไปที่ service ชื่อ "ollama" ใน internal network
# (host ภายนอก Docker ให้ใช้ http://localhost:11434 แทน)
OLLAMA_HOST=http://ollama:11434

# --- โมเดล LLM ที่จะให้ Ollama โหลดอัตโนมัติตอนสตาร์ท ---
# ต้องตรงกับ OLLAMA_MODEL ใน main.py (ค่าเริ่มต้น gemma3:4b)
OLLAMA_MODEL=gemma3:4b
